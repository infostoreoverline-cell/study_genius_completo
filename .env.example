# Le chiavi si possono inserire anche nell'interfaccia. Non pubblicare questo file compilato.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
# Concorrenza per provider: 2 e un valore prudente; intervallo consentito 1-8.
GEMINI_CONCURRENCY=2
DEEPSEEK_CONCURRENCY=2
# Directory locale contenente PDF, checkpoint e configurazione privata.
STUDYGENIUS_DATA_DIR=.studygenius
STUDYGENIUS_PORT=8765
